+++ b/internal/helper/review_cases_test.go
@@ -0,0 +1,22 @@
+package helper
+
+import (
+	"github.com/korjwl1/wireguide/internal/domain"
+	"testing"
+)
+
+func TestReviewMixedSplitPhysicalResolverPermit(t *testing.T) {
+	global := &domain.WireGuardConfig{}
+	global.Interface.DNS = []string{"9.9.9.9"}
+	global.Peers = []domain.PeerConfig{{AllowedIPs: []string{"10.0.0.0/8"}}}
+	split := &domain.WireGuardConfig{}
+	split.Interface.DNS = []string{"1.1.1.1", "~corp.example"}
+	split.Peers = []domain.PeerConfig{{AllowedIPs: []string{"172.16.0.0/12"}}}
+	permits := desiredDNSPermits([]reconcileTunnel{{Name: "global", Iface: "utun4", Cfg: global}, {Name: "split", Iface: "utun5", Cfg: split}}, "darwin", true)
+	for _, p := range permits {
+		if p.Server == "1.1.1.1" {
+			return
+		}
+	}
+	t.Fatalf("split resolver blocked by the global policy: %+v", permits)
+}
diff --git a/internal/diag/review_cases_test.go b/internal/diag/review_cases_test.go
