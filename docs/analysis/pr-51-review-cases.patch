+++ b/internal/diag/review_cases_test.go
@@ -0,0 +1,15 @@
+package diag
+
+import (
+	"github.com/korjwl1/wireguide/internal/domain"
+	"testing"
+)
+
+func TestReviewSplitDiagnosticPreservesDomainServerOwnership(t *testing.T) {
+	expected := ExpectedDNSForTunnels([][]string{{"10.1.0.53", "~a.example"}, {"10.2.0.53", "~b.example"}})
+	actual := []scutilResolver{{Domain: "a.example", Nameservers: []string{"10.2.0.53"}}, {Domain: "b.example", Nameservers: []string{"10.2.0.53"}}}
+	missing := evaluateSplitDNS(actual, domain.ParseDNSEntries(expected))
+	if len(missing) == 0 {
+		t.Fatal("diagnostic passed a.example using the wrong tunnel's DNS")
+	}
+}
