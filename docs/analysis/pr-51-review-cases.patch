@@ -0,0 +1,18 @@
+//go:build darwin
+
+package network
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestReviewSplitDNSRemovalFailureIsNotReportedAsRestored(t *testing.T) {
+	old := scutilExec
+	defer func() { scutilExec = old }()
+	scutilExec = func(string) ([]byte, error) { return nil, errors.New("dynamic store unavailable") }
+	m := &DarwinManager{}
+	if err := m.RestoreDNS("utun5"); err == nil {
+		t.Fatal("split resolver removal failed but RestoreDNS returned success")
+	}
+}
